# CORS Configuration
WEB_URL=http://localhost:3000

# Application Configuration
NODE_ENV=development
PORT=3001

# Encryption Keys (AES-256-GCM)
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# S3/MinIO Configuration (for file storage)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
