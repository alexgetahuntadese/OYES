# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=oyes_emis

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
